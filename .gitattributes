# Batch scripts must keep CRLF endings; LF-only .bat files can break
# label/goto handling on Windows.
*.bat text eol=crlf

# Everything else is normal text with LF in the repository.
*.py  text eol=lf
*.txt text eol=lf
*.md  text eol=lf
*.spec text eol=lf

# Binary assets: never touch these.
*.exe  binary
*.png  binary
*.ico  binary
*.webp binary

# Accounts and a server store written by SecretSpace 3.1.0, kept byte for
# byte: the conversion is tested on exactly what that version wrote.
sourceFiles/tests/fixtures/format1/** -text
